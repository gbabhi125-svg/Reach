# ============================================================
# REACH configuration. Copy to .env and edit. run_all.py loads this automatically.
# Every value below is a PLACEHOLDER — replace when you have real accounts.
# ============================================================

# 1 = no real SMS / geocoding / Aadhaar / GST calls (safe local dev, works offline)
# 0 = call the real providers (needs the keys below)
REACH_MOCK_EXTERNAL=1

# Nominatim (OpenStreetMap) asks for a contact email in the User-Agent
REACH_CONTACT_EMAIL=you@example.com

# Comma-separated frontend origins allowed to call the backend APIs (CORS)
REACH_CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- MSG91 (phone OTP) — https://msg91.com ---
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id

# --- Setu (Aadhaar eKYC + GST verification) — https://setu.co ---
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
SETU_PRODUCT_INSTANCE_ID=your-setu-product-instance-id
SETU_BASE_URL=https://dg-sandbox.setu.co

# --- Razorpay (payouts) — NOT wired yet, reserved for later ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
